<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_weight="1.72"
        android:background="@drawable/panel_background"
        android:clipToOutline="true">

        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fitCenter" />

        <com.xtark.pilot.camera.TargetOverlayView
            android:id="@+id/target_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/camera_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/panel_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="VISION  •  等待相机"
            android:textColor="@color/pilot_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/safety_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="14dp"
            android:backgroundTint="@color/pilot_error"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="运动锁定 · 松手即停"
            android:textColor="@color/pilot_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/control_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TARKBOT PILOT"
                android:textColor="@color/pilot_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="LG G7 视觉主控 · v0.9.1"
                android:textColor="@color/pilot_text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随目标"
                android:textColor="@color/pilot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tracking_mode_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:checkedButton="@id/person_mode_button"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/color_mode_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="颜色" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/person_mode_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="人物" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/color_target_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="颜色目标"
                android:textColor="@color/pilot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/color_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:checkedButton="@id/red_button"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/red_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="红" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/green_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="绿" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/blue_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="蓝" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/vision_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/panel_background"
                android:padding="12dp"
                android:text="未发现目标"
                android:textColor="@color/pilot_text_muted"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_person_selection_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:enabled="false"
                android:text="重新自动选择人物"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/follow_mode_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:enabled="false"
                android:text="自动跟随所选目标"
                android:textColor="@color/pilot_text_muted" />

            <TextView
                android:id="@+id/follow_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随距离：人体宽 34%（数值越大，跟得越近）"
                android:textColor="@color/pilot_text"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/follow_size_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="34"
                android:valueFrom="1"
                android:valueTo="45"
                android:stepSize="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二维码"
                android:textColor="@color/pilot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qr_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/panel_background"
                android:minHeight="56dp"
                android:padding="12dp"
                android:text="等待识别…"
                android:textColor="@color/pilot_text_muted"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenCTR H60"
                android:textColor="@color/pilot_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usb_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:padding="12dp"
                android:text="未连接 USB…"
                android:textColor="@color/pilot_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/telemetry_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/panel_background"
                android:padding="12dp"
                android:text="状态帧：0"
                android:textColor="@color/pilot_text_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_usb_button"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="连接控制器" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/disconnect_usb_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="断开" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/motion_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:enabled="false"
                android:text="解锁运动（R20-MEC）"
                android:textColor="@color/pilot_text_muted" />

            <TextView
                android:id="@+id/drive_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/panel_background"
                android:padding="10dp"
                android:text="等待连接和有效状态帧"
                android:textColor="@color/pilot_text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="速度上限：0.25 m/s（自动跟随最高 0.28 m/s）"
                android:textColor="@color/pilot_text"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/speed_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:value="25"
                android:valueFrom="5"
                android:valueTo="40"
                android:stepSize="5" />

            <com.xtark.pilot.control.DriveJoystickView
                android:id="@+id/drive_joystick"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginVertical="4dp"
                android:background="@drawable/panel_background"
                android:enabled="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/turn_left_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="按住左转" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emergency_stop_button"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="急停"
                    app:backgroundTint="@color/pilot_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/turn_right_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="按住右转" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="首次测试请架空四个轮子。只有解锁且手指持续按住摇杆/转向键时才发送运动速度；松手、切后台、断开或急停都会连续发送零速度。"
                android:textColor="@color/pilot_warning"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scroll_to_top_button"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="返回顶部" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
